# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB Atlas ----
# Atlas > Connect > Drivers > copy the connection string and add your DB name (portfolio).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# ---- CORS ----
# Comma-separated list of allowed frontend origins (no trailing slash).
CLIENT_ORIGINS=http://localhost:5173,https://your-portfolio.vercel.app

# ---- GitHub (optional) ----
GITHUB_USERNAME=priyanshipt
# Optional. A token with NO scopes raises the rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# ---- Email notifications (optional but recommended) ----
# Messages are always saved to MongoDB. If SMTP is configured they are also emailed.
# Gmail: enable 2-Step Verification, then create an App Password (never use your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=priyanshitrivedi51@gmail.com
SMTP_PASS=
MAIL_TO=priyanshitrivedi51@gmail.com
